# Ruta local al JSON de la cuenta de servicio de Google (solo para uso local)
GOOGLE_CREDS_PATH=

# Tablero CP copia (el mismo valor del secret SPREADSHEET_ID_TABLERO_CP)
SPREADSHEET_ID_TABLERO_CP=

# Opcionales (pruebas / corridas manuales)
# DRY_RUN=1                    # calcula y muestra el plan, no escribe nada
# FECHA_DATOS=2026-10-23       # simula otra fecha de datos (sólo con DRY_RUN=1 o FORZAR=1)
