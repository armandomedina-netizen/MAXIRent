# Token de la API de monday (solo lectura)
MONDAY_TOKEN=

# Ruta local al JSON de la cuenta de servicio de Google (solo para uso local; tambien se acepta GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_CREDS_PATH=

# ID del Google Sheet destino
SPREADSHEET_ID_SAC=

# Version de la API de monday (por defecto 2026-07)
# MONDAY_API_VERSION=

# Ruta del esquema del tablero (por defecto private/monday-sac-schema.json dentro de esta carpeta)
# MONDAY_SAC_SCHEMA_PATH=

# Esquema del tablero en una sola linea de JSON (lo usa GitHub Actions desde un secret)
# MONDAY_SAC_SCHEMA_JSON=
