# Credenciales (mismas que automations/maxinet-sync)

MAXINET_BASE_URL=http://189.206.77.107:8888/maxinetv2
MAXINET_USER=
MAXINET_PASS=

# Ruta local al JSON de la cuenta de servicio de Google (solo para uso local)
GOOGLE_CREDS_PATH=

# Sheet del Tablero CP copia (mismo que usan tablero-cp-cierre-diario y la guardia)
SPREADSHEET_ID_TABLERO_CP=
# Nombre o gid de la pestaña de desarrollo (con el gid un cambio de nombre no la rompe).
# Si se omite, se usa "BITACORA CP Mes Corriente" (ADR 0029)
WORKSHEET_BITACORA_NAME=BITACORA CP Mes Corriente

# Opcionales (pruebas / corridas manuales)
# FECHA_DESDE=2026-11-01   # por defecto: día 1 del mes en curso (hora CDMX)
# FECHA_HASTA=2026-11-09   # por defecto: hoy (hora CDMX)
# DRY_RUN=1                # calcula y reporta el mes, pero no escribe
# FORZAR=1                 # omite la salvaguarda que detiene la corrida si Maxinet devuelve menos del 80% de las filas del mes actual
