# Opcionales (pruebas / corridas manuales)
# FECHA_DESDE=2026-01-01   # por defecto: 1 de enero del año (o antes, si la hoja tiene órdenes sin cerrar más antiguas)
# FECHA_HASTA=2026-11-03   # por defecto: hoy (hora CDMX)
# DRY_RUN=1                # descarga, compara y reporta cuántas filas cambiarían y cuántas se agregarían, pero no escribe
# FORZAR=1                 # omite las salvaguardas de volumen (respuesta incompleta de Maxinet o cambio masivo de filas)
