# Token de la API de monday (solo lectura)
MONDAY_TOKEN=

# Ruta local al JSON de la cuenta de servicio de Google (tambien se acepta GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_CREDS_PATH=

# ID del Google Sheet que contiene la pestana MKT
SPREADSHEET_ID_MKT=

# Version de la API de monday (por defecto 2026-07)
# MONDAY_API_VERSION=

# Ruta de la configuracion con los IDs reales de monday (por defecto private/mkt-monday-config.json)
# MKT_MONDAY_CONFIG_PATH=

# Configuracion en una sola linea de JSON (la usa GitHub Actions desde un secret)
# MKT_MONDAY_CONFIG_JSON=
