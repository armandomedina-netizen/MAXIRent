# Opcionales (pruebas / corridas manuales)
# FECHA_DESDE=2026-01-01   # por defecto: mes en curso (y el anterior los primeros 3 días del mes)
# FECHA_HASTA=2026-11-26   # por defecto: hoy (hora CDMX)
# F_REGISTRO=2             # 'Clientes registrados hace' (meses): 0 = sin filtro, 1 a 6 o 12; por defecto 2
# DRY_RUN=1                # calcula y reporta el bloque, pero no escribe
# FORZAR=1                 # omite la salvaguarda que detiene la corrida si Maxinet devuelve menos del 80% del mes
