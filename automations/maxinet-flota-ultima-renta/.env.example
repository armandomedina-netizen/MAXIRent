# Credenciales (mismas que automations/maxinet-sync)

# URL base de Maxinet (la misma que usa maxinet-sync; no se versiona aquí)
MAXINET_BASE_URL=
MAXINET_USER=
MAXINET_PASS=

# Ruta local al JSON de la cuenta de servicio de Google (solo para uso local)
GOOGLE_CREDS_PATH=

# Libro del Tablero LP: el mismo SPREADSHEET_ID_SECUNDARIO que usa maxinet-sync
SPREADSHEET_ID_SECUNDARIO=
# Pestaña de destino (se crea si no existe; si ya existe se respeta su encabezado)
WORKSHEET_FLOTA_ULTIMA_RENTA=Reporte Flota Ultima Renta

# Opcionales (pruebas / corridas manuales)
# DRY_RUN=1                # descarga, calcula y reporta altas, bajas y cambios, pero no escribe ni crea la pestaña
# FORZAR=1                 # omite la salvaguarda que detiene la corrida si Maxinet devuelve menos del 80%
