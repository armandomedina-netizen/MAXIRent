# Opcionales (pruebas / corridas manuales)
# FECHA_DESDE=2026-10-01   # por defecto: mes en curso (y el anterior los primeros 3 días del mes)
# FECHA_HASTA=2026-11-18   # por defecto: hoy (hora CDMX)
# NO_RENTAS=1,2            # filtro de número de rentas (1 a 4; 4 = '4 o más'); vacío = todas
# DRY_RUN=1                # calcula y reporta el bloque, pero no escribe
# FORZAR=1                 # omite la salvaguarda que detiene la corrida si Maxinet devuelve menos del 80% del mes
