# Credenciales (mismas que automations/maxinet-sync)

# URL base de Maxinet (la misma que usa maxinet-sync; no se versiona aquí)
MAXINET_BASE_URL=
MAXINET_USER=
MAXINET_PASS=

# Ruta local al JSON de la cuenta de servicio de Google (solo para uso local)
GOOGLE_CREDS_PATH=

# Base LP copia ("BASE LP_AUTOMATIZADO"): el mismo SPREADSHEET_ID que usa maxinet-sync
SPREADSHEET_ID=
# Pestaña de destino (debe existir: la automatización no la crea; si ya trae encabezado se respeta)
WORKSHEET_MTTO_PROYECTOR=Proyección de Mantenimientos(DATA)

# Opcionales (pruebas / corridas manuales)
# DRY_RUN=1                # descarga, calcula y reporta altas, bajas y cambios, pero no escribe
# FORZAR=1                 # omite la salvaguarda que detiene la corrida si Maxinet devuelve menos del 80%
